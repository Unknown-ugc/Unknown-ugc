local function resolvePath(root, path, timeout)
	local cur = root
	for part in string.gmatch(path, "[^/]+") do
		cur = cur:WaitForChild(part, timeout)
		if not cur then return nil end
	end
	return cur
end

local function fmtPos(p)
	if typeof(p) == "CFrame" then p = p.Position end
	if typeof(p) == "Vector3" then
		return string.format("%d, %d, %d", math.floor(p.X + 0.5), math.floor(p.Y + 0.5), math.floor(p.Z + 0.5))
	end
	return nil
end

local function describe(k, v)
	local name, id, pos, count
	local rarity, size, value, players, maxPlayers, serverId, valueNum
	if type(v) == "table" then
		id         = v.Id or v.ID or v.id or v.Guid or v.GUID or v.Uid or v.UID or v.Uuid
		name       = v.Name or v.name or v.EggName or v.EggType or v.Type or v.Kind
		pos        = fmtPos(v.Position or v.Pos or v.position or v.CFrame)
		count      = v.Count or v.Amount
		rarity     = v.rarity or v.Rarity
		size       = v.sizeName or v.SizeName
		value      = v.value or v.Value
		valueNum   = v.valueNum or v.ValueNum
		players    = v.players or v.Players
		maxPlayers = v.maxPlayers or v.MaxPlayers
		serverId   = v.serverId or v.ServerId or v.jobId or v.JobId
	elseif type(v) == "number" then
		name, count = tostring(k), v
	else
		name = tostring(v)
	end
	name = tostring(name or (type(k) == "string" and k) or "Egg")

	local key
	if id then
		key = tostring(id)
	elseif serverId or valueNum then
		key = tostring(serverId or "") .. "|" .. name .. "|" .. tostring(valueNum and math.floor(valueNum) or "")
	elseif type(k) == "string" then
		key = k .. "|" .. name
	else
		key = name .. "|" .. (pos or "")
	end

	local label = name
	local meta = {}
	if rarity then meta[#meta + 1] = tostring(rarity) end
	if size then meta[#meta + 1] = tostring(size) end
	if value then meta[#meta + 1] = tostring(value) end
	if players and maxPlayers then meta[#meta + 1] = players .. "/" .. maxPlayers .. " players" end
	if #meta > 0 then label = label .. " — " .. table.concat(meta, ", ") end
	if count then label = label .. " x" .. tostring(count) end
	if pos then label = label .. " @ " .. pos end
	if serverId then label = label .. "\n   server: `" .. tostring(serverId) .. "`" end
	return { key = key, label = label }
end

local function toList(snap)
	if type(snap) ~= "table" then return {} end
	for _, field in ipairs({ "Eggs", "eggs", "Snapshot", "snapshot", "Data", "data" }) do
		if type(snap[field]) == "table" then
			snap = snap[field]
			break
		end
	end
	local out, counts = {}, {}
	for k, v in pairs(snap) do
		local e = describe(k, v)
		counts[e.key] = (counts[e.key] or 0) + 1
		if counts[e.key] > 1 then e.key = e.key .. "#" .. counts[e.key] end
		out[#out + 1] = e
	end
	return out
end

local function httpRequest(opts)
	local fn = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
	if not fn then return nil end
	return fn(opts)
end

local function sendWebhook(fresh, total)
	local url = CONFIG.WebhookUrl
	if type(url) ~= "string" or url == "" or not url:find("^https?://") then
		warn("[sx] WebhookUrl is not set, eggs found but nothing sent")
		return
	end

	local lines = {}
	for i, e in ipairs(fresh) do
		if i > 40 then
			lines[#lines + 1] = "+" .. (#fresh - 40) .. " more"
			break
		end
		lines[#lines + 1] = "• " .. e.label
	end

	local jobId = game.JobId ~= "" and game.JobId or "n/a"
	local payload = {
		username = "Egg Scan",
		embeds = {{
			title = "Egg Detector — " .. #fresh .. " new",
			description = table.concat(lines, "\n"),
			color = 0x3A96FF,
			fields = {
				{ name = "Total on field", value = tostring(total), inline = true },
				{ name = "Players", value = tostring(#Players:GetPlayers()), inline = true },
				{ name = "Place", value = tostring(game.PlaceId), inline = true },
				{ name = "Server", value = "`" .. jobId .. "`", inline = false },
			},
			footer = { text = "Egg Scan" },
			timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
		}},
	}

	local ok, res = pcall(httpRequest, {
		Url = url,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = HttpService:JSONEncode(payload),
	})
	if not ok then
		warn("[sx] webhook request failed: " .. tostring(res))
	elseif res == nil then
		warn("[sx] executor has no http request function (syn.request / request / http_request)")
	elseif type(res) == "table" and res.StatusCode and res.StatusCode >= 300 then
		warn("[sx] webhook returned " .. tostring(res.StatusCode) .. " " .. tostring(res.Body))
	end
end

local REMOTE_PATH = "RF/EggWorld/AskFieldEggSnapshot"
local warned = {}

local function warnOnce(tag, msg)
	if warned[tag] then return end
	warned[tag] = true
	warn("[sx] " .. msg)
end

local function findRemote()
	-- 1) single instance literally named with slashes (common with packet/knit style libs)
	local r = ReplicatedStorage:FindFirstChild(REMOTE_PATH, true)
	if r then return r end
	-- 2) nested folders RF > EggWorld > AskFieldEggSnapshot
	r = resolvePath(ReplicatedStorage, REMOTE_PATH, 3)
	if r then return r end
	-- 3) any descendant whose name contains the endpoint name
	for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
		if d.Name:find("AskFieldEggSnapshot", 1, true) then return d end
	end
	return nil
end

-- returns true when a snapshot was fetched and processed
local function scanOnce()
	local remote = findRemote()
	if not remote then
		warnOnce("noremote", "remote not found: " .. REMOTE_PATH)
		return false
	end
	if not remote:IsA("RemoteFunction") then
		warnOnce("badremote", "found " .. remote:GetFullName() .. " but it is a " .. remote.ClassName .. ", not RemoteFunction")
		return false
	end

	-- keep every return value, the snapshot may come as (ok, data)
	local res = table.pack(pcall(function() return remote:InvokeServer() end))
	if not res[1] then
		warnOnce("invoke", "InvokeServer failed: " .. tostring(res[2]))
		return false
	end

	local snap
	for i = 2, res.n do
		if type(res[i]) == "table" then snap = res[i] break end
	end
	if not snap then
		warnOnce("nosnap", "snapshot was not a table (got " .. typeof(res[2]) .. ")")
		return false
	end

	local eggs = toList(snap)
	local current, fresh = {}, {}
	for _, e in ipairs(eggs) do
		current[e.key] = true
		if not State.Seen[e.key] then fresh[#fresh + 1] = e end
	end
	State.Seen = current

	if #fresh > 0 then sendWebhook(fresh, #eggs) end
	return true
end

local function remainingWait()
	if State.JobId == game.JobId and State.LastScan > 0 then
		return math.max(0, CONFIG.ScanInterval - (os.time() - State.LastScan))
	end
	return 0
end

task.spawn(function()
	-- new server: reset and scan immediately
	if State.JobId ~= game.JobId then
		State.JobId = game.JobId
		State.Seen = {}
		State.LastScan = 0
	end

	while State.Gen == myGen do
		local w = remainingWait() -- same server inside the window: wait out the remainder
		local t = 0
		while t < w and State.Gen == myGen do
			task.wait(1)
			t = t + 1
		end
		if State.Gen ~= myGen then break end

		State.LastScan = os.time()
		local ok, done = pcall(scanOnce)
		if not ok then warnOnce("scanerr", "scan error: " .. tostring(done)) end
		if not ok or not done then
			-- scan did not complete: don't burn the 5 min window, retry soon
			State.LastScan = 0
			for _ = 1, 15 do
				if State.Gen ~= myGen then break end
				task.wait(1)
			end
		end
	end
end)

