	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(205, 212, 226)),
		Rotation = 90,
	}, row)
	local stroke = new("UIStroke", {
		Color = C.Border, Thickness = 1.2, Transparency = 0.1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, row)

	local textW = -(16 + BTN_W + 14 + 12)
