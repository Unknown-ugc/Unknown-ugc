		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.new(0, 16, 0, 15),
		Size = UDim2.new(1, textW, 0, 22),
	})
	label(row, {
		Text = subText,
		TextSize = 13,
		TextColor3 = C.Muted,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.new(0, 16, 0, 40),
		Size = UDim2.new(1, textW, 0, 18),
	})

	-- glow + glass button
	local btnPos = UDim2.new(1, -(14 + BTN_W / 2), 0.5, 0)

	local glow = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = btnPos,
		Size = UDim2.new(0, BTN_W + 10, 0, BTN_H + 10),
		BackgroundColor3 = C.Accent,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		ZIndex = 1,
	}, row)
	corner(glow, 14)

	local visual = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = btnPos,
		Size = UDim2.new(0, BTN_W, 0, BTN_H),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, row)
	corner(visual, 10)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.AccentLight),
			ColorSequenceKeypoint.new(0.5, C.Accent),
			ColorSequenceKeypoint.new(1, C.AccentDark),
		}),
		Rotation = 90,
	}, visual)
	local vStroke = new("UIStroke", {
		Color = C.AccentLight, Thickness = 1, Transparency = 0.45,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, visual)

	local gloss = new("Frame", {
		Position = UDim2.new(0, 3, 0, 3),
		Size = UDim2.new(1, -6, 0.5, -3),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 3,
	}, visual)
	corner(gloss, 8)
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.62),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Rotation = 90,
	}, gloss)

	local btnLabel = label(visual, {
		Text = "RUN",
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 4,
	})

	local hit = new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = btnPos,
		Size = UDim2.new(0, BTN_W, 0, BTN_H),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 10,
	}, row)

	local rowHover, btnHover, pressed = false, false, false

	local function refreshRow()
		tween(row, {
			Size = rowHover and UDim2.new(1, 4, 1, 4) or UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = rowHover and C.CardHover or C.Card,
		})
		tween(stroke, {
			Color = rowHover and C.Accent or C.Border,
			Transparency = rowHover and 0 or 0.1,
			Thickness = rowHover and 1.6 or 1.2,
		})
	end

	local function refreshBtn()
		local grow = btnHover and 4 or 0
		if pressed then grow = grow - 6 end
		tween(visual, { Size = UDim2.new(0, BTN_W + grow, 0, BTN_H + grow) })
		tween(glow, {
			Size = UDim2.new(0, BTN_W + 10 + grow * 2, 0, BTN_H + 10 + grow * 2),
			BackgroundTransparency = btnHover and 0.62 or 0.9,
		})
		tween(vStroke, {
			Thickness = btnHover and 2 or 1,
			Transparency = btnHover and 0 or 0.45,
		})
		tween(gloss, { BackgroundTransparency = btnHover and 0.05 or 0 })
	end

	wrap.MouseEnter:Connect(function() rowHover = true; refreshRow() end)
	wrap.MouseLeave:Connect(function() rowHover = false; refreshRow() end)
	hit.MouseEnter:Connect(function() btnHover = true; refreshBtn() end)
	hit.MouseLeave:Connect(function() btnHover = false; pressed = false; refreshBtn() end)
	hit.MouseButton1Down:Connect(function() pressed = true; refreshBtn() end)
	hit.MouseButton1Up:Connect(function() pressed = false; refreshBtn() end)

	local busy = false
	hit.Activated:Connect(function()
		if busy then return end
		busy = true
		btnLabel.Text = "..."
		task.spawn(function()
			local ok, err = onRun()
			if ok then
				-- done: fade the panel out, then remove the gui
				btnLabel.Text = "OK"
				task.wait(0.35)
				local t = tween(root, { GroupTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 20) }, TI_SLOW)
				t.Completed:Wait()
				gui:Destroy()
				return
			end
			btnLabel.Text = "ERR"
			warn("[sx] " .. tostring(err))
			task.wait(1.2)
			btnLabel.Text = "RUN"
			busy = false
		end)
	end)
end

