-- 4. TELEPORT COMPUTER TABLE
-- ==========================================
MakeLabel("Teleport to ComputerTable")

local function getComputerTables()
    local tables = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "ComputerTable" then
            local pos = nil
            if obj:IsA("BasePart") then pos = obj.Position
            elseif obj:IsA("Model") then pos = obj:GetPivot().Position
            else
                local part = obj:FindFirstChildWhichIsA("BasePart", true)
                if part then pos = part.Position end
            end
            if pos then table.insert(tables, { object = obj, position = pos }) end
        end
    end
    return tables
end

local function teleportToTable(index)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return warn("Character not loaded.") end
    local tables = getComputerTables()
    if #tables == 0 then return warn("No ComputerTable found.") end
    
    local targetTable = tables[index]
    if not targetTable then return warn("Table #" .. index .. " not found. Only " .. #tables .. " exist.") end

    root.CFrame = CFrame.new(targetTable.position + Vector3.new(0, 3, 0)) * root.CFrame.Rotation
    root.AssemblyLinearVelocity = Vector3.zero
    print("[Teleport] Teleported to Table #" .. index)
end

-- Buttons for Table 1 to 5
for i = 1, 5 do
    MakeButton("Teleport to Table " .. i, function()
        teleportToTable(i)
    end)
end
