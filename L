    noclipEnabled = state
end)

RunService.Stepped:Connect(function()
    if noclipEnabled and LP.Character then
        for _, part in ipairs(LP.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

