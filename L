-- Dragging Logic
local dragging, dragInput, dragStart, startPos
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Helper Functions for UI
local function MakeLabel(text)
    local l = Instance.new("TextLabel", Content)
    l.Size = UDim2.new(1, 0, 0, 20)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(200, 200, 200)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    return l
end

local function MakeButton(text, callback)
    local b = Instance.new("TextButton", Content)
    b.Size = UDim2.new(1, 0, 0, 35)
    b.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(function()
        b.BackgroundColor3 = Color3.fromRGB(58, 150, 255)
        task.wait(0.1)
        b.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
        callback()
    end)
    return b
end

local function MakeToggle(text, callback)
    local isOn = false
    local b = Instance.new("TextButton", Content)
    b.Size = UDim2.new(1, 0, 0, 35)
    b.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    b.Text = text .. " [OFF]"
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(function()
        isOn = not isOn
        if isOn then
            b.BackgroundColor3 = Color3.fromRGB(58, 150, 255)
            b.Text = text .. " [ON]"
        else
            b.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
            b.Text = text .. " [OFF]"
        end
        callback(isOn)
    end)
    return b
end

local function MakeSlider(text, min, max, default, callback)
    MakeLabel(text)
    local s = Instance.new("Frame", Content)
    s.Size = UDim2.new(1, 0, 0, 30)
    s.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    s.BorderSizePixel = 0
    Instance.new("UICorner", s).CornerRadius = UDim.new(0, 6)
    
    local fill = Instance.new("Frame", s)
    fill.Size = UDim2.new((default-min)/(max-min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(58, 150, 255)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)
    
    local txt = Instance.new("TextLabel", s)
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = tostring(default)
    txt.TextColor3 = Color3.new(1,1,1)
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 12
    txt.ZIndex = 2
    
    local draggingSlider = false
    s.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
        end
    end)
    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mouseX = math.clamp((input.Position.X - s.AbsolutePosition.X) / s.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * mouseX)
            fill.Size = UDim2.new(mouseX, 0, 1, 0)
            txt.Text = tostring(val)
            callback(val)
        end
    end)
    return s
end


-- ==========================================
-- 1. ESP PLAYER
-- ==========================================
MakeLabel("ESP Player")
local espEnabled = false
local espObjects = {}

local function createESP(player)
    if player == LP then return end
    local function addHighlight(character)
        if espObjects[character] then return end
        local highlight = Instance.new("Highlight")
        highlight.Name = "CatHubESP"
        highlight.Adornee = character
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.Parent = character
        espObjects[character] = highlight
    end
    if player.Character then addHighlight(player.Character) end
    player.CharacterAdded:Connect(function(char)
        if espEnabled then task.wait(1) addHighlight(char) end
    end)
end

MakeToggle("ESP Player", function(state)
    espEnabled = state
    if state then
        for _, player in ipairs(Players:GetPlayers()) do createESP(player) end
    else
        for char, highlight in pairs(espObjects) do
            if highlight then highlight:Destroy() end
        end
        espObjects = {}
    end
end)

