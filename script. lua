    --==================================================
    -- SEARCH
    --==================================================

    local searching = false

    local function FindServers()

        if searching then
            return
        end

        searching = true

        ServerStatus.Text = "🔎 Searching..."
        Search.Text = "🔎 SEARCHING..."

        -- Clear
        for _,v in ipairs(List:GetChildren()) do
            if v:IsA("Frame") then
                v:Destroy()
            end
        end

        local requestFunction =
            request
            or http_request
            or (syn and syn.request)

        if not requestFunction then

            ServerStatus.Text =
                "❌ HTTP request unavailable"

            Search.Text = "🔄 SEARCH"

            searching = false
            return
        end

        local found = {}
        local cursor = nil

        for page = 1,MAX_PAGES do

            local url =
                "https://games.roblox.com/v1/games/"
                ..game.PlaceId..
                "/servers/Public?sortOrder=Asc&limit=100"

            if cursor then
                url = url.."&cursor="..cursor
            end

            local ok,response = pcall(function()

                return requestFunction({
                    Url = url,
                    Method = "GET"
                })

            end)

            if not ok or not response then

                ServerStatus.Text =
                    "❌ Server request failed"

                break
            end

            local body =
                response.Body
                or response.body

            if not body then

                ServerStatus.Text =
                    "❌ Empty response"

                break
            end

            local decodeOK,data = pcall(function()

                return HttpService:JSONDecode(body)

            end)

            if not decodeOK or not data then

                ServerStatus.Text =
                    "❌ Invalid server data"

                break
            end

            for _,server in ipairs(data.data or {}) do

                local players =
                    tonumber(server.playing) or 0

                -- EXACTLY 1 PLAYER
                if players == 1
                and server.id ~= game.JobId then

                    table.insert(found,server)
                end
            end

            cursor = data.nextPageCursor

            if not cursor then
                break
            end

            task.wait(.15)
        end

        -- Sort
        table.sort(found,function(a,b)

            return (a.playing or 0)
                < (b.playing or 0)

        end)

        -- Display
        if #found == 0 then

            ServerStatus.Text =
                "❌ No 1-player servers found"

        else

            ServerStatus.Text =
                "✅ Found "..#found.." server(s)"

            for i,server in ipairs(found) do
                AddServer(server,i)
            end
        end

        Search.Text = "🔄 SEARCH 1-PLAYER SERVERS"
        searching = false
    end

    Search.MouseButton1Click:Connect(function()
        task.spawn(FindServers)
    end)

    -- Auto search
    task.spawn(function()

        task.wait(.5)

        if Gui.Parent then
            FindServers()
        end

    end)
end

