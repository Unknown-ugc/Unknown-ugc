    end)
end

local searching = false

local function findServers()

    if searching then return end
    searching = true

    clearList()
    status.Text = "Searching..."

    if not requestFunction then
        status.Text = "❌ HTTP request unavailable"
        searching = false
        return
    end

    local url =
        "https://games.roblox.com/v1/games/"
        ..game.PlaceId..
        "/servers/Public?sortOrder=Asc&limit=100"

    local ok,response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not ok or not response then
        status.Text = "❌ Request failed"
        searching = false
        return
    end

    local body = response.Body or response.body

    if not body then
        status.Text = "❌ No data"
        searching = false
        return
    end

    local decodedOk,data = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if not decodedOk then
        status.Text = "❌ Invalid data"
        searching = false
        return
    end

    local found = 0

    for _,server in ipairs(data.data or {}) do

        if server.id ~= game.JobId
        and tonumber(server.playing) == 1 then

            found += 1
            addServer(server,found)
        end
    end

    if found == 0 then
        status.Text = "No 1-player server found"
    else
        status.Text = "Found "..found.." server(s)"
    end

    searching = false
end

