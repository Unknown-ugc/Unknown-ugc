    minimized = not minimized
    ContentFrame.Visible = not minimized
    if minimized then
        MainFrame.Size = UDim2.new(0, 220, 0, 24)
    else
        MainFrame.Size = UDim2.new(0, 220, 0, ContentFrame.AbsoluteSize.Y + 28)
    end
end)
