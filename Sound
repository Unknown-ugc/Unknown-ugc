-- Sound instance
local currentSound = nil

local function playSound()
    if currentSound then
        currentSound:Stop()
        currentSound:Destroy()
    end

    local id = sidInput.Text
    if id == "" then
        setStatus("No sound ID", C.Danger)
        return
    end

    currentSound = Instance.new("Sound")
    currentSound.SoundId = id
    currentSound.Volume = currentVolume
    currentSound.Parent = SoundService

    currentSound.Loaded:Connect(function()
        local length = currentSound.TimeLength
        setStatus(string.format("Playing (%.1fs)", length), C.Success)
    end)

    currentSound.Ended:Connect(function()
        setStatus("Finished", C.Muted)
    end)

    local ok, err = pcall(function()
        currentSound:Play()
    end)

    if not ok then
        setStatus("Failed: " .. tostring(err), C.Danger)
    else
        setStatus("Loading...", C.Accent)
    end
end

