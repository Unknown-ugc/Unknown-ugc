local currentVolume = CONFIG.DefaultVolume
local dragging = false

local function updateVolume(mouseX)
    local trackX = volTrack.AbsolutePosition.X
    local trackW = volTrack.AbsoluteSize.X
    local frac = math.clamp((mouseX - trackX) / trackW, 0, 1)
    currentVolume = frac
    volFill.Size = UDim2.fromScale(frac, 1)
    volThumb.Position = UDim2.new(frac, 0, 0.5, 0)
    volLabel.Text = string.format("Volume:  %d%%", math.floor(frac * 100 + 0.5))
    if currentSound then
        currentSound.Volume = frac
    end
end

volTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        updateVolume(input.Position.X)
    end
end)

volThumb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateVolume(input.Position.X)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

