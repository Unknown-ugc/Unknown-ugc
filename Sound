local function selectPick(name)
    pickBtn.Text = "  " .. name .. string.rep(" ", math.max(1, 40 - #name)) .. "▼"
    local id = CONFIG.QuickPicks[name]
    if id and id ~= "" then
        sidInput.Text = id
